# RSVP & ucapan tamu -> Google Sheets (bukan Supabase).
# Langkah lengkap: docs/rsvp-google-sheets.md
#
# TANPA prefix NEXT_PUBLIC_ — sengaja, supaya URL ini hanya dipakai di server
# dan tidak pernah ikut terkirim ke browser tamu.
# Kalau dikosongkan, undangan tetap jalan tapi data hanya sementara
# (hilang saat redeploy) — jangan sebar link ke tamu dalam kondisi ini.
SHEETS_WEBAPP_URL=

# Opsional. Diisi setelah dapat domain final, contoh:
# NEXT_PUBLIC_SITE_URL=https://wedding-fahmi-ade.vercel.app
# Dipakai agar preview link di WhatsApp menampilkan judul & gambar dengan benar.
# Kalau dikosongkan, otomatis memakai domain Vercel.
NEXT_PUBLIC_SITE_URL=
